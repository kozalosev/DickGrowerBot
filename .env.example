TELOXIDE_TOKEN=0123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RUST_LOG=info

# OpenTelemetry: OTLP/gRPC endpoint for exporting traces to the Jaeger all-in-one bundled in
# docker-compose.yml (UI at http://localhost:16686). Leave it unset to disable export and log to
# the console only. Which host to use depends on where the BOT runs (cf. GRPC_ADDR_USER_SERVICE):
#   * Bot as a local binary, infra in Docker (the usual dev flow): localhost:4317
#   * Bot itself running inside docker-compose: jaeger:4317
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
#OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# OpenTelemetry: OTLP/HTTP endpoint for exporting the log records to the VictoriaLogs bundled in
# docker-compose.yml (UI at http://localhost:9428/select/vmui/). Leave it unset to log to the
# console only. The full URL is required, the path included. Same host rule as above:
#   * Bot as a local binary, infra in Docker (the usual dev flow): localhost:9428
#   * Bot itself running inside docker-compose: victoria-logs:9428
#OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:9428/insert/opentelemetry/v1/logs
#OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://victoria-logs:9428/insert/opentelemetry/v1/logs

# The bundled `user-service` container, the cache and the observability stack (Jaeger +
# VictoriaLogs) are optional, each gated behind a Compose profile (`user-service`, `redis` and
# `tracing`). The `infra`/`infra:full` tasks start them explicitly; for a bare
# `docker compose up` / `task up`, enable the ones you want here (comma-separated) or with
# `docker compose --profile <name> up`.
#COMPOSE_PROFILES=user-service,redis,tracing

# Docker is for infrastructure only, the bot is used as a binary
POSTGRES_HOST=localhost
# Everything's running inside Docker
#POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dickgrowerbotdb
POSTGRES_USER=dickgrowerbot
POSTGRES_PASSWORD=dgb4pwd

# DATABASE_URL is required to run a plain binary executable file for dev environment
# this line is ignored and built from the components above in `docker-compose.yml`
DATABASE_URL=postgres://dickgrowerbot:dgb4pwd@localhost:5432/dickgrowerbotdb
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=5

# The cache. Everything kept there is short-lived and can be recomputed, so leaving REDIS_HOST unset
# switches the cache off and the bot does that work instead — it starts and runs either way. The
# container runs Valkey; the variables name the protocol, which is Redis.
#   * Bot as a local binary, infra in Docker (the usual dev flow): localhost
#   * Bot itself running inside docker-compose: redis
#REDIS_HOST=localhost
#REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=r@d1shDGBtg

HELP_ADMIN_CHANNEL_RU=kozaloru
HELP_ADMIN_CHANNEL_EN=kozalo_blog
HELP_ADMIN_CHAT_RU=kozaloru_chat
HELP_ADMIN_CHAT_EN=kozalo_blog_chat
HELP_GIT_REPO=https://github.com/kozalosev/DickGrowerBot

CHATS_MERGING_ENABLED=true
TOP_UNLIMITED_ENABLED=true
MULTIPLE_LOANS_ENABLED=false
PVP_CHECK_ACCEPTOR_LENGTH=false
PVP_CALLBACK_LOCKS_ENABLED=true

#PVP_STATS_SHOW=false
#PVP_STATS_SHOW_NOTICE=true
#DISABLE_CMD_STATS=true

GROWTH_MIN=-5
GROWTH_MAX=10
GROW_SHRINK_RATIO=0.5
GROWTH_DOD_BONUS_MAX=5
NEWCOMERS_GRACE_DAYS=7
TOP_LIMIT=10
INACTIVITY_DAYS=7
PVP_DEFAULT_BET=1

# Hides dicks that are both length = 0 and inactive (haven't been grown for INACTIVITY_DAYS days)
# from /top — the daily shrink job settles neglected dicks at exactly 0 and leaves them there, so
# without this they'd pile up as dead weight at the bottom of the leaderboard.
HIDE_INACTIVE_ZERO_LENGTH_FROM_TOP=true

# Daily job (issue #15) that shrinks a dick if it hasn't been grown for DAILY_SHRINK_INACTIVITY_DAYS days,
# by up to DAILY_SHRINK_RATIO of its current length (min 1 cm). Disabled unless DAILY_SHRINK_RATIO is set > 0
# AND DAILY_SHRINK_INACTIVITY_DAYS is set > 0 — there's no separate enable flag.
#DAILY_SHRINK_RATIO=0.1
#DAILY_SHRINK_INACTIVITY_DAYS=7
# The ratio doesn't apply in full from day one of staleness: it ramps up linearly over this many
# days, starting small on the first overdue day and reaching the full DAILY_SHRINK_RATIO once a dick has
# been overdue for this many days (staying there afterwards). <= 1 disables the ramp (old behavior:
# the full ratio applies immediately once the grace period lapses).
#DAILY_SHRINK_RAMP_UP_DAYS=7
# Runs the daily shrink once at startup rather than waiting for the next UTC midnight — for trying
# the feature out locally (see scripts/seed-shrinks.sh), or for putting it into effect on deploy
# instead of hours later.
#
# Safe to leave on: the shrink doesn't touch `updated_at`, so a restart on the same day picks the
# same victims and collides on Stale_Dick_Shrinks' (chat_id, uid, created_at) key. That aborts the
# whole statement — the length change included — so a repeat run decays nobody twice and sends no
# second notification. The same holds for crash loops and for two instances booting at once.
#
# It does log an ERROR on every such repeat, which is benign but looks like a real failure. And note
# that deploying mid-day means two shrinks in quick succession: one now, one at midnight for the
# next date. Deploy just after midnight if you'd rather they stay a full day apart.
#DAILY_SHRINK_RUN_ON_STARTUP=true

# Perks
HELP_PUSSIES_COEF=0.01
LOAN_PAYOUT_COEF=0.1

# How to select winners of DoD? Possible options:
# 1) RANDOM - completely random
# 2) EXCLUSION - exclude TOP-N% (10% if ratio is 0.1)
# 3) WEIGHTS - the less your dick is the more chances you have
DOD_SELECTION_MODE=EXCLUSION
DOD_RICH_EXCLUSION_RATIO=0.1

# How fast the background jobs (the daily shrink and the self-destruction worker) may talk to
# Telegram. They share one throttle, so these numbers cover both of them together. The answers to
# users do not go through it, so leave room for them: the overall limit is set below Telegram's own
# 30 per second on purpose. Raise it only if the throttle queue keeps filling up (see the
# telegram_throttle_queue_full_total metric) while the answers to users are still fast.
#THROTTLE_MESSAGES_PER_SEC_OVERALL=20
#THROTTLE_MESSAGES_PER_SEC_CHAT=1
# The per-minute limit depends on the kind of chat. Teloxide picks the second one for every chat
# whose id starts with -100, which means supergroups as well as channels - so that is the one that
# applies to most of the chats the bot serves. The first one is left for private chats and for the
# legacy groups.
#THROTTLE_MESSAGES_PER_MIN_CHAT=5
#THROTTLE_MESSAGES_PER_MIN_SUPERGROUP=15

# Self-destruction of bot messages (issue #49). Delay in minutes before the bot deletes its
# own message; 0 (or unset) means messages of that group are permanent. Messages in private
# chats are never deleted. The four groups are:
#   NOTICE — help, privacy, error/status replies
#   REPORT — leaderboard (/top), /stats
#   EVENT — growths, DoDs, fought battles (permanent by default, as they are the chat's history)
#   APPLICATION — offers waiting for an answer (/loan, /pvp); cancelled as soon as one comes
# Telegram refuses to delete a message older than 48 hours, so longer delays are cut to 47 — the
# spare hour is for the wait between the moment a message falls due and the request that removes it.
#MSG_SELFDESTRUCT_DELAY_NOTICE_MINUTES=2
#MSG_SELFDESTRUCT_DELAY_REPORT_MINUTES=5
#MSG_SELFDESTRUCT_DELAY_EVENT_MINUTES=0
#MSG_SELFDESTRUCT_DELAY_APPLICATION_MINUTES=60
# A chat's administrators can override the four delays above with /cleanup, choosing for their
# own chat how long each group stays. These are the delays it offers them, in minutes; a chat can
# also ask for a group to be kept for good, or hand it back to the numbers above, and those two
# answers are always on offer whatever is listed here. A zero and anything past the 47-hour limit
# are dropped. An empty list leaves nothing to pick, so a chat can then only keep messages that
# would otherwise be taken away.
#MSG_SELFDESTRUCT_DELAY_OPTIONS_MINUTES=5,10,30,60,180
# Long messages are kept up at least long enough to be read: the delay is raised to
# max(group delay, reading time), where reading time = characters / this speed. Since it's
# a reading SPEED, a HIGHER value assumes a faster reader and deletes messages SOONER,
# while a LOWER value leaves them up longer. 0 disables the reading-time adjustment (only
# the flat per-group delay applies).
#MSG_SELFDESTRUCT_READING_SPEED_CPM=500
# Before deleting, the message is replaced with a localized "will be deleted in N seconds"
# warning shown for this many seconds (0 deletes immediately, without any warning).
#MSG_SELFDESTRUCT_WARNING_SECONDS=15
# What to do with the command behind a deleted answer. The bot can only remove it where it is an
# administrator allowed to delete messages, which it learns from the my_chat_member updates and
# keeps in the cache (see REDIS_* above).
#   ENABLED — the default: the answer goes, and the command with it wherever the bot may delete
#             it. When nothing is known about a chat it simply tries: a refusal costs one request
#             and is remembered
#   WITHOUT_COMMAND — the answer goes, the command is never touched
#   ONLY_WITH_COMMAND — the answer is kept unless the command can be deleted with it. This one
#             cannot guess, so where the cache knows nothing it asks Telegram first
#   DISABLED — nothing self-destructs at all, whatever the delays above say
#MSG_SELFDESTRUCT_MODE=ONLY_WITH_COMMAND
# How often the worker looks for the messages whose time has come. Pending deletions live in the
# database, so a restart loses none of them; this only bounds how late one is acted on.
#MSG_SELFDESTRUCT_POLL_SECONDS=5
# How many messages one run of the worker takes. If the runs keep taking this many (see the
# self_destruction_batch_size metric), the queue is full. The value is exported as
# self_destruction_batch_limit, so the graphs follow it and nothing else needs an edit.
#MSG_SELFDESTRUCT_BATCH_SIZE=50
# How many of them the run acts on at once. This is the knob for throughput: a run gets through
# this many messages per round trip to Telegram, while the batch size only bounds how much it
# claims. Deletions are not subject to the limits on sending messages, so the ceiling here is our
# own connection and database pools rather than Telegram's; keep it under DATABASE_MAX_CONNECTIONS,
# since every finished message writes a row. Watch
# telegram_request_errors_total{kind="rate_limited"} after raising it.
#MSG_SELFDESTRUCT_CONCURRENCY=8
# How long a taken batch is hidden from the other workers. It must be longer than a whole batch of
# throttled requests takes. Messages a worker does not finish in this time are taken again later,
# so a worker that dies in the middle of a batch loses nothing.
#MSG_SELFDESTRUCT_LEASE_SECONDS=300
# Inline messages can never be deleted, only edited, so they are replaced with a localized
# placeholder instead. Comma-separated list of the groups this applies to; empty (the default)
# leaves every inline message alone.
#MSG_SELFDESTRUCT_INLINE_GROUPS=notice
# If a deletion fails for a reason that may pass (a network problem, a rate limit), the message
# waits and is tried again, up to this many times. The wait starts at this delay and doubles after
# every failure, up to the cap below, so a chat that does not answer is asked less and less often.
# After the last attempt the row is marked `failed` and kept in the table. Keep the cap well below
# Telegram's 48 hours: after that the message can no longer be deleted at all.
#MSG_SELFDESTRUCT_RETRY_DELAY_SECONDS=60
#MSG_SELFDESTRUCT_MAX_RETRY_DELAY_SECONDS=3600
#MSG_SELFDESTRUCT_MAX_ATTEMPTS=3
# Every row that is done with is kept this many minutes before a separate cleaning process deletes
# it — `removed` (the message is gone), `expired` (it outlived Telegram's 48-hour limit while it
# waited) or `failed` (every attempt was refused). 0 keeps them for ever, which is useful while
# debugging the worker itself but grows the table without bound on a busy bot.
#MSG_SELFDESTRUCT_TABLE_CLEANING_DELAY_MINUTES=1440

# Announcements are displayed at the end of the Dick of the Day message, not more than a specified
# amount of times. They (max_shows + per-language texts) are configured in a YAML file — edit
# announcements.yml. Override the path here if needed.
#
# After editing the file, send SIGHUP to reload it without a restart:
#   docker kill -s HUP dickgrowerbot
# Nothing else is reloaded — every other value here is read once at startup.
#ANNOUNCEMENTS_FILE=announcements.yml

# to enable Webhook Mode, set to a correct URL, proxied by a reverse proxy server
#WEBHOOK_URL=https://your.domain/DickGrowerBot/webhook

# Timeouts (in seconds) for the bot's HTTP client talking to the Telegram Bot API, so a stalled
# request (e.g. when the ТСПУ/DPI equipment lets the connection hang and crawl instead of resetting
# it) fails after a bounded time instead of blocking update processing. Each is optional and
# overrides only its own knob; leaving BOTH unset keeps teloxide's stock client (defaults: 5s
# connect, 17s total).
#BOT_HTTP_CONNECT_TIMEOUT_SECONDS=5
#BOT_HTTP_TIMEOUT_SECONDS=17

# The chat where /support relays the users' messages. A group works best: you can reply from it
# and add other people later. Unset => /support is hidden from the menu and does nothing.
# Group ids are negative; get yours by forwarding a message from the group to @getmyid_bot.
#SUPPORT_CHAT_ID=-1001234567890

# How often (in seconds) the bot re-reads the list of banned users. A ban is written straight into
# the database (SELECT erase_user(...) / ban_user(...)), so nothing else tells the bot about it.
# Optional, defaults to 900 (15 minutes). SIGHUP applies a ban at once, and the database refuses to
# take a banned user back regardless of how stale this list is.
#BAN_LIST_REFRESH_SECONDS=900

### Integration with the user-service microservice (https://github.com/Kozalo-Blog/user-service).

# gRPC port the bundled user-service listens on (fixed by the service). Also used to expose
# and publish the container in docker-compose. Must be defined above GRPC_ADDR_USER_SERVICE
# so the ${...} reference expands.
USER_SERVICE_GRPC_PORT=8090

# When GRPC_ADDR_USER_SERVICE is unset, the integration is disabled: per-user languages come from
# Telegram as before and the personal /language command is hidden from private chats. The chat-wide
# /language (groups, admins-only) keeps working regardless — it's stored in our own database.
# Set it to the service's gRPC address to enable reading/updating a user's preferred
# language across all of SadBot.Dev's bots. Which host to use depends on where the BOT runs:
#   * Bot as a local binary, infra in Docker (the usual dev flow): docker-compose.override.yml
#     forwards the container's port to your machine, so use localhost:${USER_SERVICE_GRPC_PORT}.
#GRPC_ADDR_USER_SERVICE=localhost:${USER_SERVICE_GRPC_PORT}
#   * Bot itself running inside docker-compose: use the service name on the Docker network,
#GRPC_ADDR_USER_SERVICE=user-service:${USER_SERVICE_GRPC_PORT}

# How long (in seconds) to cache users fetched from the service. Optional, defaults to 360.
#USER_CACHE_TIME_SECONDS=360
# Per-request/connection timeout (in seconds) for gRPC calls to the service, so a hanging service
# can't stall update processing. Optional, defaults to 5.
#USER_SERVICE_TIMEOUT_SECONDS=5
# How long (in seconds) to cache each chat's chosen language (stored in our own DB). Optional,
# defaults to 3600 — a rather aggressive TTL is fine since we own the data.
#CHAT_LANGUAGE_CACHE_TIME_SECONDS=3600
# How long (in seconds) to cache the forum topics each chat lets the bot work in (/topics, stored
# in our own DB). Optional, defaults to 3600 — the command's own writes refresh the cache, so this
# only bounds how long another instance's change goes unnoticed.
#CHAT_TOPICS_CACHE_TIME_SECONDS=3600
# How long (in seconds) to cache what each chat chose to have cleaned up (/cleanup, stored in our
# own DB). Optional, defaults to 3600 — the command's own writes refresh the cache, so this only
# bounds how long another instance's change goes unnoticed.
#CHAT_CLEANUP_CACHE_TIME_SECONDS=3600
# How long it is worth believing what we know about the bot's rights in a chat. A promotion or a
# demotion arrives as a my_chat_member update and is stored the moment it happens, so this only
# bounds how long a change missed while the bot was down goes unnoticed. Optional, an hour when
# unset; kept in Redis when it is configured, and simply re-asked when it is not.
#BOT_ADMIN_CACHE_TIME_SECONDS=3600

# Gates the batched getMany lookup used by the daily shrink broadcast (see DAILY_SHRINK_* above) to pick
# the most popular language among a chat's players when no chat-wide language is set. Requires
# GRPC_ADDR_USER_SERVICE above to be configured; falls back to English when off.
MOST_POPULAR_LANGUAGE_ENABLED=true

# --- Local user-service run (docker-compose) ---
# The bundled `user-service` container shares the same PostgreSQL server as the bot, but
# uses its own database and role (provisioned by postgres/init-user-service-db.sh on a
# fresh data volume). These configure that database. To point the bot at the bundled
# service, uncomment GRPC_ADDR_USER_SERVICE above (localhost:… for a local binary,
# user-service:… when the bot itself runs in docker-compose).
USER_SERVICE_POSTGRES_DB=userservicedb
USER_SERVICE_POSTGRES_USER=userservice
USER_SERVICE_POSTGRES_PASSWORD=us4pwd
